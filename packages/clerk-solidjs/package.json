{
  "name": "clerk-solidjs",
  "description": "Clerk for SolidJS",
  "private": false,
  "version": "3.0.0",
  "keywords": [
    "solidjs",
    "clerk",
    "solid",
    "clerk-auth"
  ],
  "bugs": {
    "url": "https://github.com/spirit-led-software/clerk-solidjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spirit-led-software/clerk-solidjs"
  },
  "license": "MIT",
  "author": "Spirit-Led Software",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/index/index.jsx",
      "worker": "./dist/index/server.js",
      "deno": "./dist/index/server.js",
      "node": "./dist/index/server.js",
      "browser": "./dist/index/index.js",
      "default": "./dist/index/index.js"
    },
    "./experimental": {
      "types": "./dist/types/experimental.d.ts",
      "solid": "./dist/experimental/index.jsx",
      "worker": "./dist/experimental/server.js",
      "deno": "./dist/experimental/server.js",
      "node": "./dist/experimental/server.js",
      "browser": "./dist/experimental/index.js",
      "default": "./dist/experimental/index.js"
    },
    "./legacy": {
      "types": "./dist/types/legacy.d.ts",
      "solid": "./dist/legacy/index.jsx",
      "worker": "./dist/legacy/server.js",
      "deno": "./dist/legacy/server.js",
      "node": "./dist/legacy/server.js",
      "browser": "./dist/legacy/index.js",
      "default": "./dist/legacy/index.js"
    },
    "./errors": {
      "types": "./dist/types/errors.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./internal": {
      "types": "./dist/types/internal.d.ts",
      "solid": "./dist/internal/index.jsx",
      "worker": "./dist/internal/server.js",
      "deno": "./dist/internal/server.js",
      "node": "./dist/internal/server.js",
      "browser": "./dist/internal/index.js",
      "default": "./dist/internal/index.js"
    },
    "./start": {
      "types": "./dist/types/start/index.d.ts",
      "solid": "./dist/start/index.jsx",
      "worker": "./dist/start/server.js",
      "deno": "./dist/start/server.js",
      "node": "./dist/start/server.js",
      "browser": "./dist/start/index.js",
      "default": "./dist/start/index.js"
    },
    "./start/server": {
      "types": "./dist/types/start/server/index.d.ts",
      "default": "./dist/start/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "dev:publish": "pnpm run dev -- --env.publish",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rimraf dist",
    "publish:local": "pnpm dlx yalc push --replace  --sig"
  },
  "dependencies": {
    "@clerk/backend": "^3.33.0",
    "@clerk/shared": "^4.49.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@clerk/clerk-js": "^6.47.0",
    "@clerk/localizations": "^4.27.0",
    "@clerk/ui": "^1.45.0",
    "@eslint/js": "^10.0.1",
    "@solidjs/babel-plugin": "^2.0.3",
    "@solidjs/router": "^2.0.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "expect-type": "^1.3.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.3",
    "solid-js": "^2.0.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
